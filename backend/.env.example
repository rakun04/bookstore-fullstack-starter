# Application Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=bookstore
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# External Services
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# File Storage Configuration
STORAGE_TYPE=s3 # local or s3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=bookstore-uploads
UPLOAD_PATH=uploads

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_PRODUCTION=false
MIDTRANS_SANDBOX_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_PRODUCTION_URL=https://api.midtrans.com/v2

# Xendit Payment Gateway (Alternative)
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_PUBLIC_KEY=your-xendit-public-key

# Email Service Configuration
EMAIL_SERVICE=ses # ses, sendgrid, nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@bookstore.com

# AWS SES Configuration
AWS_SES_REGION=ap-southeast-1
AWS_SES_ACCESS_KEY_ID=your-aws-ses-access-key
AWS_SES_SECRET_ACCESS_KEY=your-aws-ses-secret-key

# SendGrid Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@bookstore.com

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Shipping API (RajaOngkir)
RAJAONGKIR_API_KEY=your-rajaongkir-api-key
RAJAONGKIR_URL=https://api.rajaongkir.com/starter

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Monitoring and Logging
LOG_LEVEL=debug
ENABLE_METRICS=true
ENABLE_PROFILING=false

# Features
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_REVIEWS=true
ENABLE_WISHLIST=true
ENABLE_NEWSLETTER=true

# File Upload Limits
MAX_FILE_SIZE=5242880 # 5MB in bytes
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# Caching
CACHE_TTL=3600 # 1 hour in seconds
CACHE_MAX_SIZE=100

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Notification
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# Google Analytics
GOOGLE_ANALYTICS_TRACKING_ID=your-ga-tracking-id

# Sentry Error Tracking
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Webhooks
MIDTRANS_WEBHOOK_PATH=/payments/midtrans/notification
WEBHOOK_SECRET=your-webhook-secret