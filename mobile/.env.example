# Application Configuration
FLUTTER_APP_NAME=Bookstore App
FLUTTER_APP_VERSION=1.0.0
FLUTTER_BUILD_NUMBER=1

# API Configuration
API_BASE_URL=http://localhost:3001/v1
API_TIMEOUT=30000

# Environment
FLUTTER_ENV=development

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Social Login
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payment Gateways
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_PRODUCTION=false

# Analytics
FIREBASE_ANALYTICS_ENABLED=true
FIREBASE_ANALYTICS_API_KEY=your-firebase-api-key
FIREBASE_ANALYTICS_APP_ID=your-firebase-app-id
FIREBASE_ANALYTICS_MEASUREMENT_ID=your-firebase-measurement-id

# Push Notifications
FIREBASE_MESSAGING_ENABLED=true
FCM_SERVER_KEY=your-fcm-server-key

# Crash Reporting
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Feature Flags
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_RATING_SYSTEM=true
ENABLE_WISHLIST=true
ENABLE_SOCIAL_SHARING=true

# UI Configuration
DEFAULT_THEME=system
PRIMARY_COLOR=blue
DEFAULT_LANGUAGE=id_ID

# E-commerce Configuration
DEFAULT_CURRENCY=IDR
SUPPORTED_CURRENCIES=IDR,USD
DEFAULT_LANGUAGE=id_ID
SUPPORTED_LANGUAGES=id_ID,en_US

# App Store Configuration
APP_STORE_ID=your-app-store-id
PLAY_STORE_ID=your-play-store-id

# Customer Support
SUPPORT_EMAIL=support@bookstore.com
SUPPORT_PHONE=+62812345678
SUPPORT_WHATSAL=+62812345678

# Social Media
FACEBOOK_URL=https://facebook.com/bookstore
INSTAGRAM_URL=https://instagram.com/bookstore
TWITTER_URL=https://twitter.com/bookstore

# Legal
PRIVACY_POLICY_URL=https://bookstore.com/privacy
TERMS_OF_SERVICE_URL=https://bookstore.com/terms

# Deep Links
DYNAMIC_LINKS_DOMAIN=https://bookstore.page.link
WEB_DOMAIN=https://bookstore.com

# Local Storage
CACHE_MAX_SIZE=100MB
CACHE_DURATION=7_days

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_LOGIN_ATTEMPTS=5

# Image Quality
IMAGE_QUALITY=85
THUMBNAIL_SIZE=200x200

# Video Streaming (if applicable)
VIDEO_STREAMING_ENABLED=false
VIDEO_QUALITY=auto

# Map Configuration
MAP_DEFAULT_LAT=-6.2088
MAP_DEFAULT_LNG=106.8456
MAP_DEFAULT_ZOOM=10

# Search
SEARCH_DEBOUNCE_MS=500
MAX_SEARCH_RESULTS=50

# Shopping Cart
CART_EXPIRY_HOURS=24
MAX_CART_ITEMS=50

# Order Processing
ORDER_EXPIRY_HOURS=2
PAYMENT_TIMEOUT_MINUTES=30

# Localization
DATE_FORMAT=dd MMMM yyyy
TIME_FORMAT=HH:mm
CURRENCY_SYMBOL=Rp

# Performance
ENABLE_PERFORMANCE_MONITORING=false
MEMORY_PROFILING=false

# Security
ENABLE_CERTIFICATE_PINNING=false
ALLOW_SCREEN_CAPTURE=true